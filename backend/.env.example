# Copy this file to .env and fill in your values
PORT=5000
# macOS (Homebrew MySQL, root with no password):
#   mysql://root@localhost:3306/event_portal
# Windows/Linux (password set during install):
#   mysql://root:YOUR_PASSWORD@localhost:3306/event_portal
DATABASE_URL=mysql://root:yourpassword@localhost:3306/event_portal
JWT_SECRET=change-this-to-a-long-random-string
